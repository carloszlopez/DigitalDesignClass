GROUP("SEL")
{
	MEMBERS = "SW[8]", "SW[7]", "SW[6]";
}

GROUP("SW")
{
	MEMBERS = "SW[5]", "SW[4]", "SW[3]", "SW[2]", "SW[1]", "SW[0]";
}

TRANSITION_LIST("LEDR")
{
	NODE
	{
		REPEAT = 1;
		LEVEL X FOR 512.0;
	}
}

TRANSITION_LIST("LEDR[0]")
{
